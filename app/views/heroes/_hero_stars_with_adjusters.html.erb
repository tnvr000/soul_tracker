<div class="data adjust-stat-container">
  <%= link_to adjust_stat_hero_path(hero, direction: :decrement, attribute: :stars, partial: partial),
    class: 'adjust-stat',
    data: { turbo_method: :patch, turbo_stream: true} do
  %>
    <i class="bi bi-chevron-down"></i>
  <% end %>
  <%= render partial: 'hero_stars', locals: { hero: hero } %>
  <%= link_to adjust_stat_hero_path(hero, direction: :increment, attribute: :stars, partial: partial),
    class: 'adjust-stat',
    data: { turbo_method: :patch, turbo_stream: true} do
  %>
    <i class="bi bi-chevron-up"></i>
  <% end %>
</div>
