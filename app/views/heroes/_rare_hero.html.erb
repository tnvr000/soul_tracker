<%= turbo_frame_tag hero do %>
  <div class="hero-container stripes <%= hero.hero_type %>">
    <div class="data name"><%= link_to hero.name, hero_path(hero), data: { turbo_frame: '_top' } %></div>
    <div class="data"><%= hero.hero_type %></div>
    <div class="data"><%= heroes_remaining_to_reach_8_stars(hero) %></div>
    <div class="data change-count-container">
      <%= link_to change_count_hero_path(hero, direction: 'decrease'), class: 'change-count', data: { turbo_method: :patch, turbo_stream: true } do %>
        <i class="bi bi-chevron-down"></i>
      <% end %>
      <span class="count"><%= hero.count %></span>
      <%= link_to change_count_hero_path(hero, direction: 'increase'), class: 'change-count', data: { turbo_method: :patch, turbo_stream: true } do %>
        <i class="bi bi-chevron-up"></i>
      <% end %>
    </div>
  </div>
<% end %>
