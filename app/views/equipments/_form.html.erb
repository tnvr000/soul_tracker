<%= bootstrap_form_with(model: equipment) do |form| %>
  <%= form.text_field :name, required: true %>
  <%= form.number_field :level %>
  <%= form.select :equipment_type, equipment_type_form_options %>
  <%= form.select :equipment_style, equipment_style_form_options %>
  <%= form.select :equipment_class, equipment_class_form_options %>
  <%= form.select :equipment_class_level, equipment_class_level_form_options %>

  <div class="row">
    <div class="col-lg-6">
      <div class="d-grid">
        <%= form.submit "Save", class: "btn btn-success" %>
      </div>
    </div>
    <div class="col-lg-6">
      <div class="d-grid">
        <%= link_to "Back", equipments_path, class: "btn btn-warning" %>
      </div>
    </div>
  </div>
<% end %>
